# Your MetaMask private key (export from MetaMask > Account Details > Show Private Key)
# ⚠️ NEVER commit this file with a real key. Use .env only.
PRIVATE_KEY=your_private_key_here

# Optional: Sepolia RPC (for testing on Ethereum testnet)
SEPOLIA_RPC=https://rpc.sepolia.org

# Optional: BOT Chain Explorer API key for contract verification  
EXPLORER_API_KEY=
